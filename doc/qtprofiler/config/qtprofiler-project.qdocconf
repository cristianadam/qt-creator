project     = qtprofiler
description = "Qt Profiler"
url         = https://doc.qt.io/qtprofiler

# Project contains only .qdoc sources, no PCH to generate
moduleheader =

# Words to ignore for auto-linking
ignorewords += \
    macOS \
    WebAssembly

headerdirs =
sourcedirs = ../src

imagedirs = ../images

# exampledirs = ../examples
# examples.fileextensions += *.qml *.svg

include(../../config/macros.qdocconf)
include(../../config/qt-cpp-ignore.qdocconf)
include(../../config/qt-defines.qdocconf)
include(../../config/icon-macros.qdocconf)

# These four resolve from the Qt Documentation component, so a direct
# qdoc run with -indexdir pointing at C:\Qt\Docs\Qt-X.Y.Z finds them.
depends +=    qtcore \
              qtcreator \
              qtdoc \
              qtqml \
              qtquick

# {TODO: add "qtcreator" to depends once this set needs to link into Qt
# Creator topics - the Profiler mode pages are the likely targets.
# qtcreator.index is produced by Qt Creator's own doc build, not shipped
# in Qt's Documentation component, so a direct qdoc run cannot resolve it;
# it only works from the CMake build, where add_qtc_documentation passes
# QTC_INDEX_DIR. Adding it early buys nothing but a warning per run}

defines += qtprofiler

sources.fileextensions         = "*.qdoc"

qhp.projects            	  = QtProfiler
qhp.QtProfiler.file             = qtprofiler.qhp
qhp.QtProfiler.namespace        = org.qt-project.qtprofiler
qhp.QtProfiler.virtualFolder    = doc
qhp.QtProfiler.indexTitle       = Qt Profiler
qhp.QtProfiler.filterAttributes = qtprofiler
qhp.QtProfiler.customFilters.QtProfiler.name = Qt Profiler
qhp.QtProfiler.customFilters.QtProfiler.filterAttributes = \
    qtprofiler
qhp.QtProfiler.indexRoot        =

qhp.QtProfiler.subprojects = manual
qhp.QtProfiler.subprojects.manual.title = Qt Profiler
qhp.QtProfiler.subprojects.manual.indexTitle = All topics
qhp.QtProfiler.subprojects.manual.type = manual

# Doxygen compatibility commands

macro.see                       = "\\sa"
macro.function                  = "\\fn"

# Product name macros

macro.QTP                     = "Qt Profiler"

navigation.homepage = "Qt Profiler"

# Auto-generate navigation linking based on "All topics":
navigation.toctitles = "All topics"
navigation.toctitles.inclusive = false

buildversion = "Qt Profiler"

codelanguages = Shell JSON CMake

# {TODO: set warninglimit = 0 once the scaffold carries real content and
# the build is clean. Leaving it unset while {TODO} markers and missing
# images remain would fail CI on the first run}
