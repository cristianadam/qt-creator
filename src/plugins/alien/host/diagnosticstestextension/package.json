{
    "name": "alien-diagnostics-test",
    "publisher": "theqtcompany",
    "displayName": "Alien Diagnostics Test Extension",
    "description": "Publishes a diagnostic through vscode.languages for opened documents.",
    "version": "0.0.1",
    "engines": { "vscode": "^1.0.0" },
    "main": "./extension.js",
    "activationEvents": [ "*" ],
    "contributes": {
        "languages": [
            { "id": "plaintext", "extensions": [ ".txt", ".alientxt" ] }
        ]
    }
}
