    "version": "0.0.1",
    "engines": { "vscode": "^1.0.0" },
    "main": "./extension.js",
    "activationEvents": [ "*" ],
    "contributes": {
        "languages": [
            { "id": "plaintext", "extensions": [ ".txt", ".alientxt" ] }
        ]
    }
